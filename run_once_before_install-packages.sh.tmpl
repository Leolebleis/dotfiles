{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -e

if ! command -v brew > /dev/null 2>&1; then
    echo "Homebrew not found — install it from https://brew.sh"
    exit 1
fi

command -v zellij > /dev/null 2>&1 || brew install zellij
command -v ghostty > /dev/null 2>&1 || brew install --cask ghostty
command -v bun > /dev/null 2>&1 || brew install bun
command -v pwsh > /dev/null 2>&1 || brew install --cask powershell

{{ else if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -e

if ! command -v zellij > /dev/null 2>&1; then
    echo "zellij not found — install from https://zellij.dev/documentation/installation"
fi

if ! command -v ghostty > /dev/null 2>&1; then
    echo "ghostty not found — install from https://ghostty.org/download"
fi

if ! command -v bun > /dev/null 2>&1; then
    echo "bun not found — install with: curl -fsSL https://bun.sh/install | bash"
fi

if ! command -v pwsh > /dev/null 2>&1; then
    echo "pwsh not found — zellij-attention hooks will be skipped. Install: https://learn.microsoft.com/powershell/scripting/install/installing-powershell-on-linux"
fi

{{ end -}}
